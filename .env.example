# Copy to .env and fill in. The Clerk publishable key is safe to expose in the
# frontend (it is public by design). Get it from dashboard.clerk.com →
# your app → API Keys → "Publishable key" (starts with pk_test_ or pk_live_).
# Leave unset to disable auth (the app runs offline with no sign-in gate).
VITE_CLERK_PUBLISHABLE_KEY=
