{
  "name": "autoclaw-trading",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Isolated finance-research module (OpenRouter + Ling 3.0 Flash Fin). Research and analysis only \u2014 no market predictions, no trade execution.",
  "scripts": {
    "research": "node research.mjs",
    "market": "node market-data.mjs",
    "options": "node blackscholes.mjs",
    "describe": "node describe-candles.mjs",
    "groww": "node groww-data.mjs",
    "serve": "node server.mjs",
    "paper": "node paper-bot/run.mjs",
    "paper:tech": "node paper-bot/run.mjs --tech-only",
    "paper:backtest": "node paper-bot/run.mjs --backtest",
    "paper:backtest:tech": "node paper-bot/run.mjs --backtest --tech-only",
    "paper:15m": "node paper-bot/run.mjs --tech-only --interval 15m",
    "test": "node --test",
    "eval": "node paper-bot/evaluate.mjs",
    "calibrate": "node paper-bot/evaluate.mjs --interval 1d --save && node paper-bot/evaluate.mjs --interval 60m --save && node paper-bot/evaluate.mjs --interval 15m --save && node paper-bot/evaluate.mjs --interval 5m --save",
    "monitor": "node paper-bot/monitor.mjs",
    "collect": "node paper-bot/collector.mjs",
    "backfill": "node paper-bot/collector.mjs --groww-backfill 120",
    "ranking": "node paper-bot/ranking.mjs --universe nifty200 --horizon 20",
    "vol": "node paper-bot/volatility.mjs"
  }
}
